+void InitializePixelPortWiimote()
+{
+  Config::SetBase(Config::WIIMOTE_1_SOURCE, WiimoteSource::Emulated);
+  Common::IniFile profiles;
+  auto* profile = profiles.GetOrCreateSection("Wiimote1");
+  profile->Set("Source", 1);
+  profile->Set("Options/Sideways Wiimote", true);
+  profile->Set("Extension", "None");
+  profiles.Save(File::GetUserPath(D_CONFIG_IDX) + "WiimoteNew.ini");
+  Wiimote::Initialize(Wiimote::InitializeMode::DO_NOT_WAIT_FOR_WIIMOTES);
+  auto* remote = Wiimote::GetConfig()->GetController(0);
+  remote->LoadConfig(profile);
+  remote->SetInputOverrideFunction([](std::string_view group, std::string_view control,
+                                       ControlState) -> std::optional<ControlState> {
+    InputStateSnapshot input;
+    {
+      const std::lock_guard<std::mutex> lock(s_input_state_mutex);
+      input = s_input_state;
+    }
+    const double seconds = std::chrono::duration<double>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    return PixelPortWii::Override({input.mask, input.stick_x, input.stick_y,
+                                  input.c_stick_x}, group, control, seconds);
+  });
+}
